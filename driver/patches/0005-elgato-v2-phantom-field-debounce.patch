@@ -663,7 +688,17 @@
 	if (dma_q->current_field != field_number) {
 		cxdbg_field_change(dma_q, field_number);
 
-		cx231xx_reset_video_buffer(dev, dma_q);
+		if (elgato_fielddebounce > 0 &&
+		    dev->model == CX231XX_BOARD_ELGATO_VIDEO_CAPTURE_V2 &&
