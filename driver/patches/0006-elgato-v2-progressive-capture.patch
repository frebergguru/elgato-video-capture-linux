+/*
+ * Progressive capture (Elgato V2 only, off by default).
+ *
+ * A NES/SNES emits 240p/288p: a progressive picture with no half-line field
+ * offset. The decoder has nothing to lock field detection onto, so the SAV
+ * field bit is unreliable -- measured on this box, one field per frame period
+ * carries 288 lines and the other carries an average of 4, and which label
+ * lands on the substantive one varies.
+ *
+ * The stock assembler cannot cope: cx231xx_is_buffer_done() only completes on
+ * field 2 with field1_done set, and cx231xx_do_copy() puts field 1 on even
+ * rows and field 2 on odd rows. With an unreliable label that yields buffers
+ * spliced from several moments -- ~85% of frames here.
+ *
+ * RETIRED -- MEASURED WORSE, 2026-08-24. Against a chroma-coherence metric
+ * validated on frames inspected by eye, this scored 54.4% of frames corrupt
+ * against 12.8% with it off. Keep the code as a recorded negative result: the
+ * field-assembly fault it addresses is real (the counters above prove short
+ * fields and phantom transitions) but it is a symptom, not the cause, and
+ * forcing one field into both rows costs more than it recovers. Default 0.
+ *
+ * In this mode the label is ignored entirely: a buffer is complete after
+ * lines_per_field lines whatever they were labelled, each line is written
+ * twice so the 288 real lines fill all 576 rows, and a new buffer is started
+ * when the previous one has been handed on rather than on a field change.
+ * Vertical detail is unchanged -- the source only ever had 288 lines.
+ */
+static int elgato_progressive;
+module_param(elgato_progressive, int, 0644);
+MODULE_PARM_DESC(elgato_progressive,
+	"Elgato V2: treat the source as progressive; ignore the field bit and line-double one field into each frame");
+
+static bool elg_prog(struct cx231xx *dev)
+{
+	return elgato_progressive &&
+	       dev->model == CX231XX_BOARD_ELGATO_VIDEO_CAPTURE_V2;
+}
+
 static unsigned long cxdbg_debounced;
 static unsigned long cxdbg_f12, cxdbg_f21, cxdbg_fodd;
