--- pristine/cx231xx-avcore.c
+++ cx231xx/cx231xx-avcore.c
@@ -16,6 +16,7 @@
 #include <linux/module.h>
 #include <linux/kernel.h>
 #include <linux/bitmap.h>
+#include <linux/delay.h>
 #include <linux/i2c.h>
 #include <linux/mm.h>
