#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Hypnotize
# elgato-viewer -- watch the Elgato Video Capture live, with low enough
#                  latency to play games on.
#
# Design notes, because the non-obvious choices here are the whole point:
#
#  * Video and audio travel on SEPARATE paths. Video goes V4L2 -> GStreamer ->
#    screen; audio goes ALSA -> PipeWire -> speakers via bin/elgato-audio. Pulling
#    the audio into the GStreamer pipeline instead would force the video to wait
#    on an audio clock that is derived from a different crystal to the USB
#    capture clock, and the two drift. On a long session that shows up as
#    periodic stalls or a slowly growing lip-sync error. Kept apart, each side
#    free-runs at its own rate and PipeWire adaptively resamples the audio.
#
#  * The video sink runs sync=false, i.e. a frame is drawn the moment it lands
#    rather than being held back until its timestamp is due. That removes a
#    frame-and-a-bit of buffering latency, which is the difference between
#    playable and not. Nothing is lost by it: the capture card is already the
#    clock, so there is no second timeline to sync to.
#
#  * The queue in front of the sink is short and leaky=downstream. If the
#    compositor ever stalls, old frames are dropped instead of accumulating --
#    latency stays flat and you see a dropped frame rather than a growing delay.
#
#  * Deinterlacing defaults to 'yadif', which measured best on both combing
#    and retained vertical detail and costs about 5ms. The lower-latency
#    single-field methods are still a --deinterlace away: 'linear' is 0.3ms but
#    combs on motion and loses about 17% of the vertical detail. See the
#    measurements beside DEINTERLACERS in libexec/elgato-player.py.
#
# This script is deliberately self-contained: it shells out to elgato-audio,
# elgato-reset and elgato-doctor, but shares no library with them.

set -uo pipefail

SELF_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)

USB_ID="0fd9:0037"
CARD_NAME="Elgato Video Capture"
# The v4l2loopback node --share publishes on. Must match card_label in
# etc/modprobe.d/v4l2loopback-elgato.conf.
SHARE_CARD_NAME="Elgato Share"

# ---------------------------------------------------------------- output ----
if [[ -t 2 ]]; then
    C_RED=$'\033[1;31m'; C_YEL=$'\033[1;33m'; C_GRN=$'\033[1;32m'; C_OFF=$'\033[0m'
else
    C_RED=''; C_YEL=''; C_GRN=''; C_OFF=''
fi
msg()  { printf '%s>>%s %s\n' "$C_GRN" "$C_OFF" "$*" >&2; }
warn() { printf '%s!!%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }
err()  { printf '%sxx%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; }
die()  { err "$*"; exit 1; }

# ----------------------------------------------------------------- usage ----
usage() {
    cat <<EOF
usage: ${0##*/} [options]

Play the Elgato Video Capture full-screen-able, low latency, with sound.

  -i, --input WHICH     composite (default) | svideo | 0 | 1
      --pal             force the PAL standard
      --ntsc            force the NTSC standard
                        (default: leave whatever the device is already on)

  -f, --fullscreen      start full screen
  -s, --size WxH        window size (default ${DEF_W}x${DEF_H}, 4:3)
      --sharp           nearest-neighbour scaling; crisp pixels, no blur
      --deinterlace M   yadif (default) | greedyh | linear | weave | none
                          yadif    cleanest: least combing and keeps the most
                                   vertical detail. Measured 5ms of latency.
                          greedyh  very close to yadif, 1.7ms
                          linear   lowest latency (0.3ms) but combs on motion
                                   and loses about 17% of vertical detail
                          weave    no processing; combs badly on motion
                          none     no deinterlacer in the pipeline at all

      --no-audio        do not start the audio loopback
      --latency MS      audio loopback latency (default 15)

      --reset           power-cycle the capture box first (runs elgato-reset)
      --check           run the pre-flight checks and exit
      --tune            sweep the driver's elgato_* fix knobs, measure each
                        with --verify and report which one stabilises the
                        picture. Needs root.
      --record FILE     while playing, also write the raw captured frames to
                        FILE. Headerless YUYV at about 21 MB/s, for analysis --
                        for a file you can actually play, press r instead.
      --record-dir DIR  where the r key writes recordings
                        (default ~/elgato, created the first time it is used)
      --shot-dir DIR    where the s key writes screenshots (default ~/elgato)
      --record-codec C  ffv1 (default) | h264
                          ffv1  lossless: exactly the frames the card delivered,
                                still interlaced. 4.5 MB/s measured on console
                                output, more on noisy tape. Nothing is thrown
                                away, so this is the one to archive a tape
                                with. Needs gst-libav.
                          h264  deinterlaced to 50fps and encoded at quantizer
                                18 -- around a twentieth of the size and still
                                hard to fault by eye, but no longer the
                                original. Needs gst-plugins-ugly.
      --no-record-audio do not mux the capture audio into recordings
      --record-av-offset MS
                        move the recorded audio against the picture, in
                        milliseconds; positive is later (default 0). The
                        picture and the sound reach this machine by different
                        routes, and what is left after both are timestamped is
                        a constant offset. To find yours: record something with
                        a sharp sound you can see happen, play it back with
                          mpv FILE
                        and hold Ctrl-plus / Ctrl-minus until it looks right --
                        mpv prints "Audio delay: +0.040" as you go. Multiply
                        by 1000 and pass it here to bake it in.
      --field-order F   top (default) | bottom -- which field of a recorded
                        frame comes first. The card does not say, and a player
                        told the wrong one makes motion judder or step
                        backwards. Same knob as elgato-obs-setup --field.
      --share [DEV]     also publish the captured frames on a v4l2loopback
                        device (default /dev/elgato-share) so OBS or anything
                        else can read them while you watch. Only one program
                        can open the card, so this is how to feed two. The
                        frames go out exactly as captured -- still interlaced,
                        still 720x576 -- so each side deinterlaces its own way.
                        Sound needs nothing: PipeWire already hands the capture
                        audio to every reader that asks. See OBS.md.
      --quality [SECS]  measure picture quality -- crosstalk, sharpness,
                        detail and noise -- and exit (default 8s). Use it to
                        compare settings; --verify checks integrity instead.
      --verify [SECS]   measure frame integrity and exit (default 6s).
                        Reports what fraction of frames the driver assembles
                        correctly -- use it to A/B a driver change.
  -d, --device PATH     V4L2 node (default: autodetect)
  -h, --help            this

Keys (with the video window focused):
  f     fullscreen on/off        r     start/stop recording (MKV, with sound)
  z     smaller window           s     save a screenshot (PNG)
  x     larger window            c     cycle deinterlacer (picture quality)
  m     mute/unmute the audio    h     show these keys on screen
                                 q     quit   (Esc closes help, or quits)

Keys need python-gobject, gtk4 and gst-plugin-gtk4. Without them it still
plays; close the window or press Ctrl-C to quit.

If it will not start, run  elgato-doctor  for a full diagnosis.
EOF
}

# --------------------------------------------------------------- defaults ----
DEF_W=960; DEF_H=720

DEVICE=""
INPUT="composite"
STANDARD=""
FULLSCREEN=0
SIZE=""
SCALE_METHOD="bilinear"
DEINTERLACE="yadif"
WANT_AUDIO=1
AUDIO_LATENCY="${ELGATO_AUDIO_LATENCY_MS:-15}"
DO_RESET=0
CHECK_ONLY=0
VERIFY=0
VERIFY_SECS=6
QUALITY=0
QUALITY_SECS=8
RECORD=""
SHARE=0
SHARE_DEV=""
TUNE=0
BEST_SPEC=""
# Where the r and s keys put what they capture. One directory for both, so a
# session's recordings and stills sit next to each other; created on first use,
# never at startup, so merely running the viewer leaves no trace.
CAPTURE_DIR="$HOME/elgato"
RECORD_DIR=""
SHOT_DIR=""
RECORD_CODEC="ffv1"
RECORD_AUDIO=1
# Milliseconds to move the recorded audio against the picture. Zero until
# somebody measures otherwise -- see --record-av-offset in the usage above for
# how to find the number.
RECORD_AV_OFFSET=0
# The card reports "interlaced" without saying which field is first, so a
# recording has to be told. Top is what elgato-obs-setup defaults to for this
# hardware; the symptom of getting it wrong is motion that judders or steps
# backwards. See OBS.md.
FIELD_ORDER="top"

# Options that take a value: report a missing one ourselves rather than
# letting bash print its own message with a line number in it.
need() { [[ $# -ge 2 && -n $2 ]] || die "$1 needs a value"; }

while (( $# )); do
    case "$1" in
        -i|--input)       need "$@"; INPUT=$2; shift 2 ;;
        --pal)            STANDARD="pal";  shift ;;
        --ntsc)           STANDARD="ntsc"; shift ;;
        -f|--fullscreen)  FULLSCREEN=1; shift ;;
        -s|--size)        need "$@"; SIZE=$2; shift 2 ;;
        --sharp)          SCALE_METHOD="nearest-neighbour"; shift ;;
        --deinterlace)    need "$@"; DEINTERLACE=$2; shift 2 ;;
        --no-audio)       WANT_AUDIO=0; shift ;;
        --latency)        need "$@"; AUDIO_LATENCY=$2; shift 2 ;;
        --reset)          DO_RESET=1; shift ;;
        --check)          CHECK_ONLY=1; shift ;;
        --tune)           TUNE=1; shift ;;
        --record)         need "$@"; RECORD=$2; shift 2 ;;
        --record-dir)     need "$@"; RECORD_DIR=$2; shift 2 ;;
        --shot-dir)       need "$@"; SHOT_DIR=$2; shift 2 ;;
        --record-codec)   need "$@"; RECORD_CODEC=$2; shift 2 ;;
        --no-record-audio) RECORD_AUDIO=0; shift ;;
        --record-av-offset) need "$@"; RECORD_AV_OFFSET=$2; shift 2 ;;
        --field-order)    need "$@"; FIELD_ORDER=$2; shift 2 ;;
        --share)          SHARE=1
                          if [[ ${2:-} == /dev/* ]]; then SHARE_DEV=$2; shift; fi
                          shift ;;
        --quality)        QUALITY=1
                          if [[ ${2:-} =~ ^[0-9]+$ ]]; then QUALITY_SECS=$2; shift; fi
                          shift ;;
        --verify)         VERIFY=1
                          if [[ ${2:-} =~ ^[0-9]+$ ]]; then VERIFY_SECS=$2; shift; fi
                          shift ;;
        -d|--device)      need "$@"; DEVICE=$2; shift 2 ;;
        -h|--help)        usage; exit 0 ;;
        *)                usage >&2; die "unknown option: $1" ;;
    esac
done

case "$INPUT" in
    composite|composite1|comp|0) INPUT_N=0; INPUT_NAME="Composite" ;;
    svideo|s-video|1)            INPUT_N=1; INPUT_NAME="S-Video" ;;
    *) die "--input must be composite or svideo (got '$INPUT')" ;;
esac

case "$DEINTERLACE" in
    linear|yadif|weave|greedyh|none) ;;
    *) die "--deinterlace must be yadif, greedyh, linear, weave or none (got '$DEINTERLACE')" ;;
esac

case "$RECORD_CODEC" in
    ffv1|h264) ;;
    *) die "--record-codec must be ffv1 or h264 (got '$RECORD_CODEC')" ;;
esac

[[ $RECORD_AV_OFFSET =~ ^-?[0-9]+$ ]] \
    || die "--record-av-offset takes whole milliseconds (got '$RECORD_AV_OFFSET')"
(( RECORD_AV_OFFSET >= -1000 && RECORD_AV_OFFSET <= 1000 )) \
    || die "--record-av-offset is in milliseconds; beyond a second it is not a lip-sync correction any more (got '$RECORD_AV_OFFSET')"

case "$FIELD_ORDER" in
    top)    FIELD_CAPS="top-field-first" ;;
    bottom) FIELD_CAPS="bottom-field-first" ;;
    *) die "--field-order must be top or bottom (got '$FIELD_ORDER')" ;;
esac

[[ -n $RECORD_DIR ]] || RECORD_DIR=$CAPTURE_DIR
[[ -n $SHOT_DIR   ]] || SHOT_DIR=$CAPTURE_DIR

if [[ -n $SIZE ]]; then
    [[ $SIZE =~ ^([0-9]+)x([0-9]+)$ ]] || die "--size must look like 960x720 (got '$SIZE')"
    OUT_W=${BASH_REMATCH[1]}; OUT_H=${BASH_REMATCH[2]}
else
    OUT_W=$DEF_W; OUT_H=$DEF_H
fi

for tool in gst-launch-1.0 v4l2-ctl; do
    command -v "$tool" >/dev/null || die "$tool is not installed"
done

# --------------------------------------------------------------- helpers ----

settle() { sleep 0.5; }

# The capture chip exposes several /dev/video* nodes; only one of them actually
# does video capture. Match on the card name and then confirm the capability,
# so we never hand the pipeline the VBI or metadata node.
find_device() {
    local d caps
    if [[ -c /dev/elgato ]]; then
        echo /dev/elgato
        return 0
    fi
    for d in /dev/video*; do
        [[ -c $d ]] || continue
        v4l2-ctl -d "$d" --info 2>/dev/null | grep -q "$CARD_NAME" || continue
        caps=$(v4l2-ctl -d "$d" --info 2>/dev/null | sed -n '/Device Caps/,$p')
        [[ $caps == *"Video Capture"* ]] || continue
        echo "$d"
        return 0
    done
    return 1
}

device_present() { lsusb 2>/dev/null | grep -qi "$USB_ID"; }

# The loopback node --share writes into. This mirrors find_device above rather
# than sharing it, because the capability test has to be inverted: with
# exclusive_caps=1 a v4l2loopback node that nobody is writing to yet advertises
# Video *Output*, not Video Capture, so find_device's filter would reject the
# very node we are looking for. It only becomes a camera once we attach.
find_share_device() {
    local d caps
    if [[ -c /dev/elgato-share ]]; then
        echo /dev/elgato-share
        return 0
    fi
    for d in /dev/video*; do
        [[ -c $d ]] || continue
        v4l2-ctl -d "$d" --info 2>/dev/null | grep -q "$SHARE_CARD_NAME" || continue
        caps=$(v4l2-ctl -d "$d" --info 2>/dev/null | sed -n '/Device Caps/,$p')
        [[ $caps == *"Video Output"* || $caps == *"Video Capture"* ]] || continue
        echo "$d"
        return 0
    done
    return 1
}

# Everything that has to be true before the pipeline can tee into the loopback.
# Failing here with a specific instruction beats letting GStreamer report a
# negotiation error thirty lines deep.
share_preflight() {
    if [[ -z $SHARE_DEV ]]; then
        SHARE_DEV=$(find_share_device) || {
            err "no v4l2loopback device found for --share"
            if [[ -d /sys/module/v4l2loopback ]]; then
                err "the module is loaded but has no '$SHARE_CARD_NAME' node --"
                err "check /etc/modprobe.d/v4l2loopback-elgato.conf, then:"
                err "    sudo modprobe -r v4l2loopback && sudo modprobe v4l2loopback"
            else
                err "load it with:  sudo modprobe v4l2loopback"
                err "or set it up for good by re-running this repository's install.sh"
            fi
            return 1
        }
    fi

    [[ -c $SHARE_DEV ]] || { err "$SHARE_DEV is not a character device"; return 1; }

    # Refuse anything that is not a loopback. --share takes a path, and writing
    # frames into somebody's actual webcam is not a mistake worth allowing.
    if ! v4l2-ctl -d "$SHARE_DEV" --info 2>/dev/null | grep -q "v4l2 loopback"; then
        err "$SHARE_DEV is not a v4l2loopback device -- refusing to write to it"
        return 1
    fi
    [[ -w $SHARE_DEV ]] || {
        err "$SHARE_DEV is not writable by you"
        err "the udev rule tags it uaccess; try replugging or re-running install.sh"
        return 1
    }

    # v4l2loopback takes one writer but any number of readers, and readers are
    # the normal case -- OBS is configured to keep its handle open across
    # restarts of this viewer, so an open fd on this node means nothing on its
    # own. What matters is whether the output token is taken, and with
    # exclusive_caps=1 that is exactly what the announced capability says: a
    # node with a writer attached calls itself Video Capture, an idle one calls
    # itself Video Output.
    if v4l2-ctl -d "$SHARE_DEV" --info 2>/dev/null \
        | sed -n '/Device Caps/,$p' | grep -q "Video Capture"; then
        local holders
        holders=$(share_holders "$SHARE_DEV")
        err "$SHARE_DEV already has a writer${holders:+ -- open by: $holders}"
        err "stop the other producer first; only one can publish at a time"
        return 1
    fi

    # keep_format pins the node to announcing CAPTURE for ever (v4l2loopback.c:
    # querycap only offers OUTPUT when the output token is free AND keep_format
    # is clear), so no writer can attach and v4l2sink fails with the thoroughly
    # unhelpful "is not a output device". "v4l2loopback-ctl set-caps" sets it,
    # and it survives the process that set it. Clearing it is one unprivileged
    # ioctl, so just do it rather than make somebody decode the error.
    if [[ $(v4l2-ctl -d "$SHARE_DEV" --get-ctrl keep_format 2>/dev/null) == *": 1" ]]; then
        v4l2-ctl -d "$SHARE_DEV" --set-ctrl keep_format=0 >/dev/null 2>&1 \
            && msg "cleared keep_format on $SHARE_DEV (something had pinned it)" \
            || { err "$SHARE_DEV is pinned by keep_format and it will not clear"
                 err "reload the module:  sudo modprobe -r v4l2loopback && sudo modprobe v4l2loopback"
                 return 1; }
    fi

    # No format is pinned here on purpose. v4l2loopback-ctl set-caps needs root,
    # and it works by setting exactly the keep_format flag cleared above.
    return 0
}

# Who holds a device, by name, without pulling in psmisc for fuser.
share_holders() {
    local dev=$1 target fd out="" names=""
    target=$(readlink -f "$dev")
    for fd in /proc/[0-9]*/fd/*; do
        [[ $(readlink -f "$fd" 2>/dev/null) == "$target" ]] || continue
        local pid=${fd#/proc/}; pid=${pid%%/*}
        [[ $pid == "$$" ]] && continue
        # one process can hold several fds on the same node; name it once
        [[ " $out " == *" $pid "* ]] && continue
        out+="$pid "
        names+="$(cat "/proc/$pid/comm" 2>/dev/null)($pid) "
    done
    echo "${names% }"
}

# Count control-transfer failures since the box last enumerated. This hardware
# wedges its USB link fairly readily; once it has, every symptom above it is a
# red herring and only a power cycle clears it.
usb_errors_since_plug() {
    journalctl -k -b --no-pager 2>/dev/null | awk '
        /cx231xx.*[Nn]ew device|USB Video Class|cx231xx.*successfully/ { n = 0 }
        /cx231xx/ && /-71|EPROTO/                                     { n++ }
        END { print n + 0 }'
}

delivers_frames() {
    local dev=$1 count=${2:-10} secs=${3:-8}
    timeout "$secs" v4l2-ctl -d "$dev" --stream-mmap --stream-count="$count" \
        --stream-to=/dev/null >/dev/null 2>&1
}

# Put the card back on the standard's full frame before measuring anything.
#
# This chip implements S_FMT scaling, so whatever geometry it was last asked
# for is the geometry it is still in -- a standard change does not reset it.
# The measuring paths below all read the format rather than setting it, so
# anything that has previously asked the card for a smaller picture silently
# redefines what --verify and --quality are scoring: a --verify that announces
# "180x144" is measuring the hardware scaler, not the driver's frame assembly.
#
# Pinning here rather than trusting G_FMT makes the figures mean what they say,
# and repairs a card something else has shrunk. It is a no-op in the normal
# case, where the card is already on its full frame.
pin_capture_format() {
    local dev=$1 h=576
    case "$(v4l2-ctl -d "$dev" --get-standard 2>/dev/null)" in
        *NTSC*|*PAL-M*|*PAL-60*) h=480 ;;
    esac
    v4l2-ctl -d "$dev" --set-fmt-video=width=720,height=$h >/dev/null 2>&1
}

# Frames arriving proves the USB path works, not that anything is plugged into
# the yellow socket: with no source the decoder free-runs and emits a flat
# blanking level at the nominal rate. A near-zero spread across the luma plane
# is that flat level; anything else is a picture (or at least noise).
has_picture() {
    local dev=$1 raw spread
    raw=$(mktemp) || return 0
    pin_capture_format "$dev"
    if ! timeout 8 v4l2-ctl -d "$dev" --stream-mmap --stream-count=8 \
            --stream-to="$raw" >/dev/null 2>&1; then
        rm -f "$raw"; return 0
    fi
    # Sample a band from the VERTICAL MIDDLE of the last frame. Taking the
    # tail of the file instead lands in the black band at the bottom of the
    # picture, whose spread is zero -- which reported "no picture" on a
    # perfectly good one.
    local fsz lines skip
    fsz=$(v4l2-ctl -d "$dev" --get-fmt-video 2>/dev/null | sed -n 's/.*Size Image *: *//p' | head -1)
    [[ -n ${fsz:-} && $fsz -gt 0 ]] || fsz=829440
    lines=$(( fsz / 1440 ))
    (( lines < 8 )) && lines=576
    # start of the last frame, then a third of the way down it
    skip=$(( ($(stat -c%s "$raw") / fsz - 1) * fsz + (lines / 3) * 1440 ))
    spread=$(dd if="$raw" bs=1 skip="$skip" count=200000 2>/dev/null | od -An -tu1 -v | awk '
        { for (i = 1; i <= NF; i++) if ((c++) % 2 == 0) {
              v = $i; n++; s += v; ss += v * v } }
        END { if (n < 100) { print 999; exit }
              m = s / n; d = ss / n - m * m; if (d < 0) d = 0
              printf "%d\n", sqrt(d) }')
    rm -f "$raw"
    [[ -n $spread ]] && (( spread > 3 ))
}

# ------------------------------------------------------------- pre-flight ----

preflight() {
    local dev=$1 rc=0

    if ! device_present; then
        err "no Elgato Video Capture on the USB bus (expected $USB_ID)"
        err "plug it into a direct USB-A port, not a hub"
        return 1
    fi

    local eproto; eproto=$(usb_errors_since_plug)
    if (( eproto > 0 )); then
        warn "$eproto USB control-transfer errors since the box last enumerated"
        warn "the link is probably wedged; if this fails, run:  ${0##*/} --reset"
    fi

    if ! delivers_frames "$dev"; then
        err "the device is not delivering frames"
        if (( eproto > 0 )); then
            err "the USB link is wedged -- power-cycle it:  ${0##*/} --reset"
        else
            err "check the source is on and the standard is right (--pal / --ntsc)"
            err "for a full diagnosis:  elgato-doctor"
        fi
        return 1
    fi

    # The decoder's horizontal lock is the difference between a picture you
    # can play on and one that tears: measured 0% of frames corrupt with
    # elgato_htl=2 against ~60% with it off. It is not the driver default, so
    # say so rather than letting the picture look mysteriously bad.
    local htl=/sys/module/cx231xx/parameters/elgato_htl
    if [[ -r $htl && $(<"$htl") == 0 ]]; then
        warn "elgato_htl is 0 -- the decoder's horizontal lock is not being set,"
        warn "which tears roughly 60% of frames. Enable it with:"
        warn "    sudo sh -c 'echo 2 > $htl' && v4l2-ctl -d $dev -s pal"
        warn "or make it permanent in /etc/modprobe.d/cx231xx.conf:"
        warn "    options cx231xx elgato_htl=2"
    fi

    if ! has_picture "$dev"; then
        warn "frames are flowing but carry no picture -- the capture side is fine,"
        warn "so check the yellow RCA lead is seated at both ends and the source"
        warn "is powered on. Opening the window anyway."
        rc=0
    fi
    return $rc
}

# ----------------------------------------------------------------- audio ----

AUDIO_STARTED=0

start_audio() {
    (( WANT_AUDIO )) || return 0
    local helper="$SELF_DIR/elgato-audio"
    if [[ ! -x $helper ]]; then
        warn "elgato-audio not found next to this script; running without sound"
        return 0
    fi
    if ELGATO_AUDIO_LATENCY_MS="$AUDIO_LATENCY" "$helper" start; then
        AUDIO_STARTED=1
    else
        warn "audio did not start -- video only. Run elgato-doctor to see why."
    fi
}

stop_audio() {
    (( AUDIO_STARTED )) || return 0
    "$SELF_DIR/elgato-audio" stop >/dev/null 2>&1
    AUDIO_STARTED=0
}

# The pipeline runs in the background (see the run loop) so that a signal
# arriving here is handled straight away. Were gst-launch in the foreground,
# bash would defer this trap until it exited -- and since the signal goes to
# this script rather than to gst, that is never, leaving an orphaned pipeline
# holding the capture device open so nothing else can use it.
GST_PID=""

kill_pipeline() {
    [[ -n $GST_PID ]] || return 0
    kill -0 "$GST_PID" 2>/dev/null || { GST_PID=""; return 0; }
    # SIGINT first: gst-launch turns that into a clean shutdown, which releases
    # the V4L2 buffers properly. Only escalate if it will not go.
    kill -INT "$GST_PID" 2>/dev/null
    local i
    for i in $(seq 20); do
        kill -0 "$GST_PID" 2>/dev/null || break
        sleep 0.1
    done
    kill -0 "$GST_PID" 2>/dev/null && kill -KILL "$GST_PID" 2>/dev/null
    GST_PID=""
}

cleanup() {
    local rc=$?
    trap - EXIT INT TERM
    kill_pipeline
    stop_audio
    exit $rc
}


# ---------------------------------------------------------------- verify ----
#
# Counting delivered frames is not enough: this capture chip can hand over a
# buffer of exactly the right size, at exactly the right rate, whose contents
# are spliced together from two different moments in time. Those frames look
# torn, and no amount of buffering downstream repairs them -- the data really
# is mixed.
#
# The tell is temporal: if the driver alternates between assembling a frame
# correctly and assembling one across a frame boundary, then consecutive frames
# differ far more than frames two apart. On a healthy capture the two are
# comparable. The ratio is the measurement.

verify_stream() {
    local dev=$1 secs=$2 raw w h sz
    pin_capture_format "$dev"
    read -r w h sz < <(v4l2-ctl -d "$dev" --get-fmt-video 2>/dev/null | awk '
        /Width\/Height/ { split($3, a, "/"); w = a[1]; h = a[2] }
        /Size Image/     { sz = $4 }
        END { print w, h, sz }')
    [[ -n ${sz:-} && $sz -gt 0 ]] || { err "could not read the capture format"; return 1; }

    local want=$(( secs * 25 ))
    (( want < 20 )) && want=20
    raw=$(mktemp) || return 1

    msg "Capturing ${want} frames (${w}x${h}) to measure frame integrity..."
    if ! timeout $(( secs + 12 )) v4l2-ctl -d "$dev" --stream-mmap \
            --stream-count="$want" --stream-to="$raw" >/dev/null 2>&1; then
        rm -f "$raw"; err "capture failed"; return 1
    fi

    python3 - "$raw" "$w" "$h" "$sz" "${3:-report}" <<'PYEOF'
import sys

path, w, h, sz = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
mode = sys.argv[5] if len(sys.argv) > 5 else "report"
STEP_ROW  = 4     # rows sampled per frame
STEP_PIX  = 8     # chroma samples per row
THRESH    = 9.0   # mean |chroma difference| between lines two apart

with open(path, 'rb') as fh:
    data = fh.read()
n = len(data) // sz
if n < 4:
    if mode != "report":
        print("RATIO=nan")
    else:
        print("  not enough frames to judge")
    sys.exit(1)

# Corrupt frames on this capture chip show rainbow striping: the chroma
# changes wildly from one line to the next. A clean picture has flat
# colour fields, so lines two apart (same field, and skipping the duplicate
# when progressive line-doubling is on) agree closely. Validated against
# frames inspected by eye: clean scored 2.6, corrupt 13.5.
stride = w * 2

# Returns (mean, worst-5%). The mean is the historical figure and still the
# pass/fail one, so scores stay comparable with everything measured before.
# The percentile is reported beside it because the mean has a measured blind
# spot: it averages the whole frame, so on dark low-chroma material -- a
# console title screen on black -- frames that are visibly sheared and carry
# duplicated text score about 3 against THRESH 9 and pass. Same frames, worst
# 5% of samples: 21. The threshold is absolute while the statistic is
# content-dependent, which is the flaw.
def chroma_score(fi):
    base = fi * sz
    vals = []
    for y in range(20, h - 2, STEP_ROW):
        o1 = base + y * stride
        o2 = base + (y + 2) * stride
        for x in range(0, w * 2 - 4, 4 * STEP_PIX):
            vals.append(abs(data[o1 + x + 1] - data[o2 + x + 1]))   # U
            vals.append(abs(data[o1 + x + 3] - data[o2 + x + 3]))   # V
    if not vals:
        return 0.0, 0.0
    vals.sort()
    return (sum(vals) / len(vals),
            float(vals[min(len(vals) - 1, int(len(vals) * 0.95))]))

# A black or disconnected input has perfectly coherent chroma -- zero
# variation everywhere -- and would otherwise score a clean 0% corrupt. Refuse
# to pass judgement when there is no picture to judge.
def luma_spread(fi):
    base = fi * sz
    vals = []
    for y in range(20, h - 2, STEP_ROW * 2):
        o = base + y * stride
        for x in range(0, w * 2 - 4, 4 * STEP_PIX):
            vals.append(data[o + x])
    m = sum(vals) / len(vals)
    return (sum((v - m) ** 2 for v in vals) / len(vals)) ** 0.5

detail = sum(luma_spread(i) for i in range(0, n, max(1, n // 8))) / len(range(0, n, max(1, n // 8)))
if detail < 5.0:
    if mode != "report":
        print("RATIO=nan")
    else:
        print(f"  frames analysed : {n}")
        print(f"  picture detail  : {detail:.1f}  (essentially flat)")
        print()
        print("  VERDICT: NO PICTURE -- frames are arriving but carry no image,")
        print("  so there is nothing to judge. Check the source is on and the")
        print("  lead is seated, then run this again.")
    sys.exit(3)

pairs = [chroma_score(i) for i in range(n)]
scores = [m for m, _ in pairs]
peaks = [p for _, p in pairs]
bad = sum(1 for v in scores if v > THRESH)
pct = 100.0 * bad / n
lo, hi = min(scores), max(scores)

if mode != "report":
    print(f"RATIO={pct:.2f}")
    sys.exit(0 if pct <= 5.0 else 2)

print(f"  frames analysed : {n}")
print(f"  corrupt frames  : {bad} of {n}  ({pct:.1f}%)")
print(f"  chroma spread   : {lo:.1f} (best frame) .. {hi:.1f} (worst)  threshold {THRESH}")
# Reported, not judged: no threshold has been calibrated for it on raw YUYV.
# A known-good capture of this hardware measures 14.0 here, so the mean's
# threshold of 9.0 emphatically does NOT transfer to this statistic.
print(f"  worst 5% samples: {min(peaks):.1f} .. {max(peaks):.1f}"
      f"   (uncalibrated; good captures measure ~14 -- for comparing runs only)")
print()
if pct > 5.0:
    print("  VERDICT: BROKEN -- corrupt frames show rainbow striping, i.e. the")
    print("  chroma changes wildly line to line. A clean picture has flat")
    print("  colour fields. This is below the player: raw v4l2 capture shows it.")
    sys.exit(2)
print("  VERDICT: OK -- colour is coherent line to line on every frame.")
print()
print("  This test has a known blind spot: the figure above is a frame AVERAGE")
print("  against an absolute threshold, so damage confined to part of the")
print("  picture is diluted. Measured on a console title screen, elgato_htl=0")
print("  scored 0.0% corrupt here while stills of that same capture were")
print("  sheared diagonally with text duplicated, 20 frames out of 20. A pass")
print("  is not proof; look at the picture, or save a still with the s key.")
PYEOF
    local rc=$?
    rm -f "$raw"
    return $rc
}

# --------------------------------------------------------------- quality ----
#
# --verify answers "is the driver assembling frames correctly". This answers a
# different question: how clean is the picture it assembles. A capture can score
# 0% corrupt and still be full of dot crawl.
#
# The dominant artefact on composite is chroma/luma crosstalk: the decoder cannot
# fully separate the two, so luma detail leaks into chroma and chroma speckles
# along luma edges. Measure it as the ratio of chroma activity beside hard luma
# edges to chroma activity in flat areas. 1.0 would be perfect separation.
#
# Crucially this is reported next to sharpness, never alone. Any low-pass filter
# improves the crosstalk number by blurring the picture -- measured on this
# capture, a 3-tap blur takes crosstalk 7.14 -> 5.42 while sharpness collapses
# 34.0 -> 19.2. A single "quality score" would happily optimise for mush.
quality_stream() {
    local dev=$1 secs=$2 raw w h sz
    pin_capture_format "$dev"
    read -r w h sz < <(v4l2-ctl -d "$dev" --get-fmt-video 2>/dev/null | awk '
        /Width\/Height/ { split($3, a, "/"); w = a[1]; h = a[2] }
        /Size Image/     { sz = $4 }
        END { print w, h, sz }')
    [[ -n ${sz:-} && $sz -gt 0 ]] || { err "could not read the capture format"; return 1; }

    local want=$(( secs * 25 ))
    (( want < 30 )) && want=30
    raw=$(mktemp) || return 1

    msg "Capturing ${want} frames (${w}x${h}) to measure picture quality..."
    if ! timeout $(( secs + 15 )) v4l2-ctl -d "$dev" --stream-mmap \
            --stream-count="$want" --stream-to="$raw" >/dev/null 2>&1; then
        rm -f "$raw"; err "capture failed"; return 1
    fi

    python3 - "$raw" "$w" "$h" "$sz" "${3:-report}" <<'PYEOF'
import sys

path, w, h, sz = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
mode = sys.argv[5] if len(sys.argv) > 5 else "report"

ROW_STEP = 4     # rows sampled
PIX_STEP = 8     # chroma pairs sampled along a row
EDGE     = 40    # luma gradient that counts as a hard edge
FLAT     = 5     # luma gradient that counts as flat

with open(path, 'rb') as fh:
    data = fh.read()
n = len(data) // sz
if n < 8:
    if mode != "report":
        print("QUALITY=nan")
    else:
        print("  only %d frames captured -- not enough to judge." % n)
        print("  The device may still be settling; wait a few seconds and retry.")
    sys.exit(1)

stride = w * 2

def pct(vals, p):
    if not vals:
        return 0.0
    v = sorted(vals)
    return float(v[min(len(v) - 1, int(len(v) * p / 100.0))])

# --- spatial metrics, measured on many frames across the capture -------------
# Reading a single frame ties every figure to whatever was on screen at that
# instant: on a moving source the same setting measured 89 one run and 6 the
# next. Sampling frames spread through the capture and taking the median makes
# the result describe the setting rather than the moment. The spread is reported
# too, so content variability is visible instead of hidden.
FRAMES = 12
picks = [int(round(i * (n - 1) / float(FRAMES - 1))) for i in range(FRAMES)] \
        if n >= FRAMES else list(range(n))

xs = list(range(20, h - 4, ROW_STEP))
cs, ss, vs = [], [], []
for fi in picks:
    base = fi * sz
    edge_c, flat_c, hgrad, vgrad = [], [], [], []
    for y in xs:
        o1 = base + y * stride
        o2 = base + (y + 2) * stride      # two rows down: crosses a doubled line
        for x in range(0, w * 2 - 8, 4 * PIX_STEP):
            g = abs(data[o1 + x] - data[o1 + x + 4])
            hgrad.append(g)
            vgrad.append(abs(data[o1 + x] - data[o2 + x]))
            dc = abs(data[o1 + x + 1] - data[o1 + x + 5]) \
               + abs(data[o1 + x + 3] - data[o1 + x + 7])
            if g > EDGE:
                edge_c.append(dc)
            elif g < FLAT:
                flat_c.append(dc)
    if edge_c and flat_c:
        cs.append((sum(edge_c) / len(edge_c)) / max(sum(flat_c) / len(flat_c), 0.01))
    ss.append(pct(hgrad, 95))
    vs.append(pct(vgrad, 95))

if not cs:
    if mode != "report":
        print("QUALITY=nan")
    else:
        print("  the picture has too little contrast to measure crosstalk")
    sys.exit(1)

crosstalk = pct(cs, 50)
ct_lo, ct_hi = min(cs), max(cs)
sharp = pct(ss, 50)
vdet = pct(vs, 50)

# --- temporal noise ----------------------------------------------------------
# Per-pixel standard deviation over time. Moving pixels dominate the high end, so
# the median is the noise floor of the static majority.
spots = []
for y in range(20, h - 4, ROW_STEP * 4):
    for x in range(0, w * 2 - 8, 4 * PIX_STEP * 2):
        spots.append(y * stride + x)
sds = []
static = 0
for off in spots:
    vals = [data[i * sz + off] for i in range(n)]
    m = sum(vals) / n
    sd = (sum((v - m) ** 2 for v in vals) / n) ** 0.5
    sds.append(sd)
    if sd < 2.0:
        static += 1
noise = pct(sds, 50)
static_frac = 100.0 * static / len(sds)

# Scene drift. These figures describe whatever the source happened to be showing,
# so comparing two configurations is only meaningful if the picture held still
# between them. Measured here by how far the last frame has moved from the first.
drift = sum(abs(data[0 * sz + o] - data[(n - 1) * sz + o]) for o in spots) / len(spots)

if mode != "report":
    print("QUALITY=%.4f %.4f %.4f %.4f %.4f" % (crosstalk, sharp, vdet, noise, drift))
    sys.exit(0)

print("  frames analysed : %d" % n)
print("  crosstalk ratio : %5.2f   chroma activity at luma edges vs flat areas"
      % crosstalk)
print("                            median of %d frames, range %.2f-%.2f"
      % (len(cs), ct_lo, ct_hi))
print("                            1.00 = perfect separation; higher = dot crawl")
print("  sharpness       : %5.1f   horizontal luma detail  <- the guard" % sharp)
print("  v-detail        : %5.1f   vertical luma detail" % vdet)
print("  noise           : %5.2f   temporal, %.0f%% of pixels static"
      % (noise, static_frac))
print("  scene drift     : %5.2f   how far the picture moved during capture" % drift)
print()
if drift > 3.0 or static_frac < 40:
    print("  WARNING: the source is moving (drift %.1f, %.0f%% static), so these"
          % (drift, static_frac))
    print("  figures are NOT comparable between runs. Measured five times on a")
    print("  moving picture, this metric swung 8.1 to 18.5 for an unchanged")
    print("  setting -- content dominates entirely.")
    print()
    print("  Crosstalk is most objectionable in motion, but it cannot be measured")
    print("  there. Hold the source still (pause, or a title screen with plenty of")
    print("  texture) to compare settings, then judge the winner by eye on moving")
    print("  material. On a still scene this metric repeats to about +/-1.5%.")
    print()
elif sharp < 12 or vdet < 12:
    print("  WARNING: the picture has very little detail (sharpness %.0f, v-detail"
          % sharp)
    print("  %.0f). Crosstalk needs hard edges to be visible. Use a screen with" % vdet)
    print("  some texture and contrast rather than a dark or flat one.")
    print()
print("  These are for COMPARING configurations, not a pass/fail. A change is an")
print("  improvement only if crosstalk falls while sharpness holds -- any blur")
print("  lowers crosstalk by destroying detail.")
PYEOF
    local rc=$?
    rm -f "$raw"
    return $rc
}

# Capture once and return just the ratio, for the sweep below.
measure_ratio() {
    verify_stream "$1" "$2" quiet 2>/dev/null | sed -n 's/^RATIO=//p'
}

# ------------------------------------------------------------------ tune ----
#
# The elgato_* knobs in the out-of-tree driver exist to fix exactly the fault
# --verify measures, but they default to off, so nothing has ever applied them.
# They take effect from cx231xx_do_mode_ctrl_overrides(), which the driver runs
# on a standard change -- so writing the parameter and then re-setting the
# standard is enough to apply one without reloading the module.

# The sweep is run twice over, interleaved, so that drift in the source
# material cannot masquerade as a difference between configurations.
TUNE_CONFIGS=(
    "baseline|htl=0 vdrst=0 timing=0 modectrl=0"
    "htl (vendor constants)|htl=1 vdrst=0 timing=0 modectrl=0"
    "htl + lock-acquire|htl=2 vdrst=0 timing=0 modectrl=0"
    "htl2 + vd reset|htl=2 vdrst=1 timing=0 modectrl=0"
    "htl2 + timing|htl=2 vdrst=0 timing=1 modectrl=0"
    "htl2 + modectrl|htl=2 vdrst=0 timing=0 modectrl=1"
    "timing only|htl=0 vdrst=0 timing=1 modectrl=0"
    "everything|htl=2 vdrst=1 timing=1 modectrl=1"
)
TUNE_PASSES=${TUNE_PASSES:-2}

apply_knobs() {
    local spec=$1 kv k v

    # elgato_progressive and elgato_fielddebounce were both tried and both
    # made things worse; zero them so a sweep never measures them by accident.
    for k in progressive fielddebounce; do
        [[ -e /sys/module/cx231xx/parameters/elgato_$k ]] \
            && echo 0 > "/sys/module/cx231xx/parameters/elgato_$k" 2>/dev/null
    done
    for kv in $spec; do
        k=${kv%%=*}; v=${kv##*=}
        echo "$v" > "/sys/module/cx231xx/parameters/elgato_$k" 2>/dev/null \
            || { err "cannot write elgato_$k -- run this as root"; return 1; }
    done
    # The overrides are applied on a standard change; re-set the current one.
    case "$(v4l2-ctl -d "$DEVICE" --get-standard 2>/dev/null | tail -1)" in
        *NTSC*) v4l2-ctl -d "$DEVICE" -s ntsc >/dev/null 2>&1 ;;
        *)      v4l2-ctl -d "$DEVICE" -s pal  >/dev/null 2>&1 ;;
    esac
    settle; settle
}

tune_sweep() {
    if [[ $EUID -ne 0 ]]; then
        err "--tune writes /sys/module/cx231xx/parameters/*, so it needs root:"
        err "    sudo $(readlink -f "$0") --tune"
        return 1
    fi
    [[ -d /sys/module/cx231xx/parameters ]] || { err "cx231xx is not loaded"; return 1; }
    [[ -e /sys/module/cx231xx/parameters/elgato_htl ]] || {
        err "this cx231xx has no elgato_* knobs -- it is not the out-of-tree build"
        return 1; }

    warn "These knobs write the decoder's PLL and horizontal-lock registers."
    warn "If the picture is still gone when this finishes, the decoder is wedged;"
    warn "setting the parameters back to 0 does NOT restore the old register"
    warn "values -- only a power cycle does. Recover with:  elgato-reset"
    echo
    warn "READ THIS BEFORE TRUSTING THE TABLE. That same persistence is what"
    warn "makes the sweep measure the wrong thing. A config is applied by"
    warn "writing the parameter and re-setting the standard, and that cannot"
    warn "undo what an earlier config already wrote -- so once any config has"
    warn "locked the decoder, every later one inherits the lock and scores as"
    warn "though it had earned it. Measured: with elgato_htl=2 applied first,"
    warn "going back to elgato_htl=0 still reported 0.0% corrupt, twice."
    warn "Interleaving the passes does not help. Drift is what the passes"
    warn "guard against; this is one-way contamination, which they do not."
    warn "To compare configurations honestly, power-cycle between each:"
    warn "    elgato-reset  then  elgato-viewer --verify   once per config."
    echo
    warn "And do not read a low figure as proof a config is good. This metric"
    warn "has a measured blind spot: its statistic is the MEAN chroma"
    warn "difference between lines two apart, but the threshold is absolute, so"
    warn "on dark low-chroma material a badly torn frame scores about 3 against"
    warn "a threshold of 9 and passes. Measured: elgato_htl=0 on a console title"
    warn "screen scored 0.0% corrupt across 20 frames while PNG stills of that"
    warn "same capture were sheared diagonally with text duplicated -- 20 of 20"
    warn "frames visibly ruined. Look at the picture, or save a still with the"
    warn "s key, before trusting any row in this table."
    echo
    msg "Sweeping ${#TUNE_CONFIGS[@]} configurations (~20s each)."
    msg "Figure is % of frames corrupt; <= 5% means the picture is stable."
    echo

    local best_name="" best_ratio="" line name spec ratio pass
    declare -A SEEN
    printf '  %-24s %-10s %s\n' "CONFIG" "%CORRUPT" "VERDICT"
    printf '  %-24s %-10s %s\n' "------" "-----" "-------"
    for pass in $(seq "$TUNE_PASSES"); do
      (( TUNE_PASSES > 1 )) && printf '  -- pass %d --\n' "$pass"
      for line in "${TUNE_CONFIGS[@]}"; do
        name=${line%%|*}; spec=${line#*|}
        apply_knobs "$spec" || return 1
        ratio=$(measure_ratio "$DEVICE" 5)
        [[ -z $ratio ]] && ratio="nan"
        local verdict="broken"
        if [[ $ratio != nan ]] && awk "BEGIN{exit !($ratio <= 5.0)}"; then
            verdict="STABLE"
        fi
        printf '  %-24s %-10s %s\n' "$name" "$ratio" "$verdict"
        if [[ $ratio != nan ]]; then
            if [[ -z $best_ratio ]] || awk "BEGIN{exit !($ratio < $best_ratio)}"; then
                best_ratio=$ratio; best_name=$name; BEST_SPEC=$spec
            fi
        fi
      done
    done

    echo
    warn "Compare each config against its OWN figure in the other pass. A"
    warn "difference that does not survive both passes is drift in the source"
    warn "material, not an effect of the setting."
    echo
    if [[ -n $best_name ]]; then
        msg "Best: $best_name (${best_ratio}% of frames corrupt)"
        apply_knobs "$BEST_SPEC"
        msg "Left the device in that configuration."
        msg "To make it permanent, add to /etc/modprobe.d/cx231xx.conf:"
        local opts=""
        for kv in $BEST_SPEC; do opts+=" elgato_${kv%%=*}=${kv##*=}"; done
        printf '    options cx231xx%s\n' "$opts" >&2
    else
        err "every configuration failed to measure"
        return 1
    fi
}


# ------------------------------------------------------------------ sink ----

# The interactive player needs PyGObject, GTK4 and gtk4paintablesink. Where any
# of those is missing -- other distros do not all ship gst-plugin-gtk4 -- fall
# back to gst-launch, which plays fine but cannot take a key press: gst-launch
# has no input plumbing, and waylandsink does not implement GstNavigation.
PLAYER="$SELF_DIR/../libexec/elgato-player.py"

have_player() {
    [[ -r $PLAYER ]] || return 1
    command -v python3 >/dev/null || return 1
    gst-inspect-1.0 gtk4paintablesink >/dev/null 2>&1 || return 1
    python3 - <<'EOF' >/dev/null 2>&1 || return 1
import gi
gi.require_version("Gst", "1.0"); gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gst, Gtk, Gdk
EOF
    return 0
}

# Decided once in the main shell, never inside pick_sink: that runs in a command
# substitution, so anything it assigns is lost with the subshell.
USE_PLAYER=0

decide_player() {
    if [[ -n ${ELGATO_VIEWER_SINK:-} ]]; then
        return              # an explicit sink override opts out, silently
    fi
    if have_player; then
        USE_PLAYER=1
        return
    fi
    warn "interactive keys unavailable -- needs python-gobject, gtk4 and"
    warn "gst-plugin-gtk4. Playing without them; close the window or Ctrl-C to quit."
}

pick_sink() {
    if (( USE_PLAYER )); then
        echo "gtk4paintablesink name=vsink sync=false"
        return
    fi
    if [[ -n ${ELGATO_VIEWER_SINK:-} ]]; then
        echo "$ELGATO_VIEWER_SINK"
    elif [[ -n ${WAYLAND_DISPLAY:-} ]] && gst-inspect-1.0 waylandsink >/dev/null 2>&1; then
        local s="waylandsink sync=false"
        (( FULLSCREEN )) && s+=" fullscreen=true"
        echo "$s"
    elif [[ -n ${DISPLAY:-} ]] && gst-inspect-1.0 xvimagesink >/dev/null 2>&1; then
        (( FULLSCREEN )) && warn "--fullscreen needs waylandsink; resize the window instead"
        echo "xvimagesink sync=false"
    elif [[ -n ${DISPLAY:-} ]]; then
        (( FULLSCREEN )) && warn "--fullscreen needs waylandsink; resize the window instead"
        echo "ximagesink sync=false"
    else
        die "no display: neither WAYLAND_DISPLAY nor DISPLAY is set"
    fi
}

# ------------------------------------------------------------------ main ----

if (( DO_RESET )); then
    reset_helper="$SELF_DIR/elgato-reset"
    [[ -x $reset_helper ]] || die "elgato-reset not found next to this script"
    msg "Power-cycling the capture box"
    "$reset_helper" || warn "reset reported a problem; carrying on"
    settle
fi

if [[ -n $DEVICE ]]; then
    [[ -c $DEVICE ]] || die "$DEVICE is not a character device"
else
    DEVICE=$(find_device) || die "no Elgato capture node found. Is it plugged in? Try: elgato-doctor"
fi

msg "Device: $DEVICE"

if [[ -n $STANDARD ]]; then
    msg "Standard: ${STANDARD^^}"
    v4l2-ctl -d "$DEVICE" -s "$STANDARD" >/dev/null 2>&1 \
        || warn "could not set the $STANDARD standard"
fi

msg "Input: $INPUT_NAME"
v4l2-ctl -d "$DEVICE" -i "$INPUT_N" >/dev/null 2>&1 \
    || warn "could not select input $INPUT_N"
settle

preflight "$DEVICE" || exit 1

# Correct the sample aspect on the way out. 720x576 and 720x480 are both 4:3
# pictures made of non-square samples; scaling them to a square-pixel window
# without saying so gives you a subtly stretched image.
FMT_H=$(v4l2-ctl -d "$DEVICE" --get-fmt-video 2>/dev/null \
        | sed -n 's|.*Width/Height *: *[0-9]*/\([0-9]*\).*|\1|p')
# SHOT_W/SHOT_H is that same 4:3 picture with the samples made square, which is
# the honest size for a still: 720 non-square samples across really are 768
# square ones on PAL and 640 on NTSC. Stills are written at this size rather
# than at the window size -- the window may be showing 1920x1440, but scaling
# up a 720-sample line adds no detail to a file somebody will look at later.
case "${FMT_H:-576}" in
    480) SRC_PAR="8/9"  ; CAP_H=480; CAP_FPS="30000/1001"
         SHOT_W=640; SHOT_H=480 ;;                            # NTSC
    *)   SRC_PAR="16/15"; CAP_H=576; CAP_FPS="25/1"
         SHOT_W=768; SHOT_H=576 ;;                            # PAL
esac
# The card only ever samples 720 across, in either standard.
CAP_W=720

(( SHARE )) && { share_preflight || exit 1; }

if (( TUNE )); then
    tune_sweep
    exit $?
fi

if (( QUALITY )); then
    quality_stream "$DEVICE" "$QUALITY_SECS"
    exit $?
fi

if (( VERIFY )); then
    verify_stream "$DEVICE" "$VERIFY_SECS"
    exit $?
fi

if (( CHECK_ONLY )); then
    cur_std=$(v4l2-ctl -d "$DEVICE" --get-standard 2>/dev/null | tail -1 | tr -d '\t')
    msg "Pre-flight passed (${cur_std:-standard unknown}) -- ready to play."
    (( SHARE )) && msg "Sharing would publish on $SHARE_DEV."
    exit 0
fi

case "$DEINTERLACE" in
    none)   DEINT="" ;;
    *)      DEINT="deinterlace name=deint mode=interlaced method=$DEINTERLACE ! " ;;
esac

decide_player
SINK=$(pick_sink)

# The r key muxes the capture audio into its recording. Resolve the PipeWire
# node name once, here, rather than in the player: elgato-audio owns the
# knowledge of what that source is called and this script deliberately shares no
# library with it. An empty answer is not fatal -- a recording then has no sound
# and the player says so on screen, which beats refusing to record at all.
REC_AUDIO_NODE=""; REC_AUDIO_RATE=48000; REC_AUDIO_CHANNELS=2
if (( USE_PLAYER && RECORD_AUDIO )); then
    read -r REC_AUDIO_NODE REC_AUDIO_RATE REC_AUDIO_CHANNELS < <(
        "$SELF_DIR/elgato-audio" record-node 2>/dev/null)
    : "${REC_AUDIO_RATE:=48000}" "${REC_AUDIO_CHANNELS:=2}"
fi

# Split the stream rather than opening the device twice -- V4L2 allows only one
# client. Every tap hangs off one tee placed ahead of the deinterlacer, so what
# leaves here is what the card delivered, not what this window is showing.
# Each branch is leaky: a slow disk, or an OBS that is not reading, drops frames
# rather than stalling the picture you are watching.
TAPS=""
if [[ -n $RECORD ]]; then
    TAPS+="tap. ! queue max-size-buffers=12 leaky=downstream ! filesink location=$RECORD async=false
    "
    msg "Recording raw frames to $RECORD (~21 MB/s)"
fi
if (( SHARE )); then
    # The PAR has to go back to 1/1 here. v4l2sink advertises
    # pixel-aspect-ratio=(fraction)1/1 and nothing else, so handing it the
    # capssetter's 16/15 fails negotiation outright -- "streaming stopped,
    # reason not-negotiated". Nothing is lost by relabelling: V4L2 has no field
    # for pixel aspect, so it could never have crossed the loopback anyway.
    # That is why consumers do the 4:3 correction themselves, exactly as they
    # already do when they open the card directly.
    #
    # The interlacing is NOT relabelled. v4l2loopback stores the field it is
    # given -- measured: readers see "Field: Interlaced" and GStreamer
    # negotiates interlace-mode=interleaved -- so consumers are told the truth
    # and deinterlace properly instead of guessing.
    #
    # async=false matters: a second sink that never prerolls would hold the
    # whole pipeline in PAUSED and the window would stay black. sync=false for
    # the same reason the display sink has it -- the card is the clock.
    TAPS+="tap. ! queue max-size-buffers=4 leaky=downstream
        ! capssetter caps=video/x-raw,pixel-aspect-ratio=(fraction)1/1
        ! v4l2sink device=$SHARE_DEV sync=false async=false io-mode=mmap
    "
    msg "Sharing the capture on $SHARE_DEV -- point OBS at it (audio needs nothing)"
fi

# The tee is always present, even with no taps configured, because the r and s
# keys request a pad from it at runtime. A tee with a single src pad forwards
# the buffer by reference and does no copying, so an idle one costs nothing
# measurable -- and building the pipeline the same way every time means the
# interactive paths are never exercising an arrangement the tested one did not.
TAP="! tee name=tap
    ${TAPS}tap. "

PIPELINE="v4l2src device=$DEVICE io-mode=mmap
    ! queue max-size-buffers=3 max-size-bytes=0 max-size-time=0 leaky=downstream
    ! capssetter caps=video/x-raw,pixel-aspect-ratio=(fraction)$SRC_PAR
    $TAP! ${DEINT}videoconvert
    ! videoscale name=vscale method=$SCALE_METHOD
    ! capsfilter name=outcaps caps=video/x-raw,width=$OUT_W,height=$OUT_H,pixel-aspect-ratio=(fraction)1/1
    ! $SINK"

trap cleanup EXIT INT TERM
start_audio

if (( USE_PLAYER )); then
    msg "Playing ${OUT_W}x${OUT_H}$( ((FULLSCREEN)) && echo " fullscreen")  (press h in the window for keys)"
else
    msg "Playing ${OUT_W}x${OUT_H}$( ((FULLSCREEN)) && echo " fullscreen")  (close the window or Ctrl-C to quit)"
fi

# A first STREAMON occasionally fails on a box that has just been reset or
# replugged -- the alt-setting change races the decoder coming up. One retry
# after a short settle turns that into a non-event rather than a failed launch.
attempt=0
while :; do
    attempt=$((attempt + 1))
    if (( USE_PLAYER )); then
        "$PLAYER" --pipeline "$PIPELINE" \
                  --width "$OUT_W" --height "$OUT_H" \
                  $( ((FULLSCREEN)) && echo --fullscreen ) \
                  --audio-helper "$SELF_DIR/elgato-audio" \
                  --device "$DEVICE" --input "$INPUT_NAME" \
                  --record-dir "$RECORD_DIR" --shot-dir "$SHOT_DIR" \
                  --record-codec "$RECORD_CODEC" \
                  --audio-node "$REC_AUDIO_NODE" \
                  --audio-rate "$REC_AUDIO_RATE" \
                  --audio-channels "$REC_AUDIO_CHANNELS" \
                  --av-offset "$RECORD_AV_OFFSET" \
                  --shot-size "${SHOT_W}x${SHOT_H}" \
                  --field-order "$FIELD_CAPS" \
                  --title "Elgato Video Capture" &
    else
        # shellcheck disable=SC2086  # the pipeline description must word-split
        gst-launch-1.0 -q $PIPELINE &
    fi
    GST_PID=$!
    wait "$GST_PID"
    rc=$?
    GST_PID=""

    (( rc == 0 )) && break                 # window closed, or clean EOS
    (( rc == 130 || rc == 2 )) && break    # Ctrl-C
    (( rc == 143 )) && break               # SIGTERM

    if (( attempt == 1 )); then
        warn "the pipeline stopped unexpectedly (exit $rc) -- retrying once"
        settle; settle
        continue
    fi

    err "could not keep the stream running (exit $rc)"
    if (( $(usb_errors_since_plug) > 0 )); then
        err "the USB link is wedged. Fix it with:  ${0##*/} --reset"
    else
        err "run  elgato-doctor  for a full diagnosis"
    fi
    exit 1
done

msg "Stopped."
