#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Hypnotize
# Recover the capture device after an experiment has left it wedged.
#
# Register experiments (the PLL at 0x108/0x110/0x8f8 especially) can leave the
# decoder in a state that a module reload does NOT clear -- setting the module
# parameter back to 0 stops writing those registers, it does not restore their
# previous values. The chip then emits a flat blanking level, or stops
# delivering frames entirely. Only a device power cycle fixes it.

set -uo pipefail
SELF_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=../lib/elgato-common.sh
source "$SELF_DIR/../lib/elgato-common.sh"

msg "Clearing all experiment parameters"
for p in /sys/module/cx231xx/parameters/elgato_*; do
    [[ -e $p ]] || continue
    case "$(basename "$p")" in
        elgato_comb|elgato_lpf) echo -1 | sudo tee "$p" >/dev/null ;;
        *)                      echo  0 | sudo tee "$p" >/dev/null ;;
    esac
done

usb_reset_elgato || die "reset failed - unplug and replug the device by hand"

DEV=$(require_device)
v4l2-ctl -d "$DEV" -i 0 >/dev/null 2>&1
v4l2-ctl -d "$DEV" -s pal >/dev/null 2>&1
settle

if has_signal "$DEV"; then
    msg "Device reset and a picture is present."
else
    warn "Device reset, but no picture yet - give it a moment and run elgato-doctor."
fi
